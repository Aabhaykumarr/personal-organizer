# ==============================================================================
# Personal Organizer - Environment Configuration Template
# Copy this file to .env and fill in your values
# ==============================================================================

# Application Security (Replace with a strong random string)
SECRET_KEY=my-super-secret-key-change-me-production-secure-key-9281

# AI Backend Provider: "groq" (recommended, ultra-fast), "openai", or "ollama"
AI_BACKEND=groq

# --- Groq Configuration (Ultra-fast inference & high performance) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- OpenAI Configuration (Optional) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Ollama Configuration (Local Offline LLM) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
